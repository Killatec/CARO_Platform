# CARO MQTT Simulator — Environment Variables
# Copy to .env and fill in POSTGRES_PASSWORD before running.
# See Bootstrap §4 for full descriptions.

# MQTT
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_CLIENT_ID=caro-simulator

# PostgreSQL (consumed by @caro/db)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=caro_dev
POSTGRES_USER=postgres
POSTGRES_PASSWORD=          # required — no default

# Simulation
TICK_INTERVAL_MS=100
SINE_PERIOD_S=30
LOG_BUFFER_SIZE=200
