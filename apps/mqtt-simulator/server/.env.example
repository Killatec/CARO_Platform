# CARO MQTT Simulator — app-local settings only.
# Project identity (PROJECT_ROOT) and database connection settings
# (POSTGRES_*) live in the monorepo root .env, not here — see ../../../.env.example.
# See Bootstrap §4 for full descriptions.

PORT=3002

# MQTT
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_CLIENT_ID=caro-simulator

# Simulation
TICK_INTERVAL_MS=100
SINE_PERIOD_S=30
LOG_BUFFER_SIZE=200
