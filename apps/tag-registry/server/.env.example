# Tag Registry Server — app-local settings only.
# Project identity (PROJECT_ROOT) and database connection settings
# (POSTGRES_*) live in the monorepo root .env, not here — see ../../../.env.example.

TEMPLATES_DIR=../templates
PORT=3001

# Optional Parent Type Validation
# Comma-separated template_type values each tag must have as an ancestor
VALIDATE_REQUIRED_PARENT_TYPES=module

# If true, no tag may have more than one ancestor of the same template_type
VALIDATE_UNIQUE_PARENT_TYPES=false
