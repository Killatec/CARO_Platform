# CARO Platform — project identity, shared by all three servers.
# Copy to .env and fill in POSTGRES_PASSWORD (and TIMESCALE_PASSWORD if you
# run the HMI historian) before running any server.
#
# Loaded by every server via @caro/server's loadEnv(): each app's own
# server/.env loads first and wins on a conflict; this file fills in whatever
# is still unset. These keys must agree across apps — see each app's own
# server/.env.example for that app's own settings (PORT, TEMPLATES_DIR, etc.),
# which do NOT belong here.

PROJECT_ROOT=CARO_1

# PostgreSQL (@caro/db)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=caro_dev
POSTGRES_USER=postgres
POSTGRES_PASSWORD=          # required — no default

# TimescaleDB (@caro/db) — HMI historian only
TIMESCALE_HOST=localhost
TIMESCALE_PORT=5433
TIMESCALE_USER=caro
TIMESCALE_PASSWORD=         # required — no default
TIMESCALE_DATABASE=caro_timescale
